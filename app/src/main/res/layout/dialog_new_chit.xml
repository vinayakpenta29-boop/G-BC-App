<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etChitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chit Fund Name"
            android:inputType="text" />

        <Spinner
            android:id="@+id/spFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etInstallmentsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of Installment"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spAmountType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Installment Amount"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/llAmountsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="First Installment Date (YYYY-MM-DD)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Members Names:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/llMembersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
