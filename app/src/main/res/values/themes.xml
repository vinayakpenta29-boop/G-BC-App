<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChitFundManager" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#1A237E</item>
        <item name="colorPrimaryDark">#0D1137</item>
        <item name="colorAccent">#00E676</item>
        
        <item name="android:windowBackground">#F4F6F9</item>
        <item name="cardBackgroundColor">#FFFFFF</item>

        <item name="materialAlertDialogTheme">@style/PremiumRoundedAlertDialogTheme</item>
        
        <item name="autoCompleteTextViewString">@string/app_name</item>
        <item name="shapeAppearanceSmallComponent">@style/PremiumRoundedComponentsSmall</item>
    </style>

    <style name="PremiumRoundedComponentsSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="PremiumRoundedAlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Premium.MediumComponent</item>
        <item name="backgroundTint">#FFFFFF</item>
    </style>

    <style name="ShapeAppearance.Premium.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
