<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChitFundManager" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#0F172A</item>
        <item name="colorPrimaryDark">#020617</item>
        <item name="colorAccent">#10B981</item>
        
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="cardBackgroundColor">#FFFFFF</item>

        <item name="materialAlertDialogTheme">@style/PremiumRoundedAlertDialogTheme</item>
        <item name="shapeAppearanceSmallComponent">@style/PremiumRoundedComponentsSmall</item>
    </style>

    <style name="PremiumRoundedComponentsSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="PremiumRoundedAlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="shapeAppearanceOverlay">@style/PremiumAlertDialogShape</item>
        <item name="backgroundTint">#FFFFFF</item>
    </style>

    <style name="PremiumAlertDialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="PremiumTabTextStyle" parent="TextAppearance.Design.Tab">
        <!-- Decreased text size to fit cleanly into sleek modern pills -->
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    
</resources>
